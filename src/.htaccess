# Hardened security configuration for the Analytify Angular build.
# This file is deployed with the application so that Apache based targets
# (qa.insightapps.ai) automatically inherit the same protections that were
# missing during the Qualys assessment.

Options -Indexes

<IfModule mod_headers.c>
  # Maintain existing CORS behaviour that the SPA relies on.
  Header always set Access-Control-Allow-Origin "*"

  # Prevent framing/clickjacking (QID 150124) and enforce HTTPS usage.
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'; upgrade-insecure-requests"

  # Enforce TLS for future requests after the redirect (QID 150150 & 150263).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Minimise information disclosure and MIME sniffing risks (QID 150520 hardening).
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always unset X-Powered-By

  # Harden cookies generated by the application/API (if any).
  Header edit Set-Cookie ^(.*)$ $1;Secure;HttpOnly;SameSite=Lax
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTP requests to HTTPS (QID 150150 & 150263).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Redirection of requests to index.html
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteRule ^.*$ - [NC,L]
  # Redirect all non-file routes to index.html
  RewriteRule ^(?!.*\.).*$ index.html [NC,L]
</IfModule>